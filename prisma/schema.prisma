generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // Hash bcrypt
  label     String   // Ej: "Juan & Tania", "Edu & Mai"
  createdAt DateTime @default(now())

  magicToken String? @unique

  /// Cuenta con acceso al panel de administración (/admin).
  /// El primer admin se puede marcar con la variable ADMIN_USERNAME.
  isAdmin Boolean @default(false)

  profiles   Profile[]
  categories Category[]

  // Configuración de gastos compartidos
  splitMode     SplitMode @default(FONDO_COMUN)
  splitPercentA Float     @default(50) // % del primer perfil (orden alfabético)
  splitPercentB Float     @default(50) // % del segundo perfil
  showSplitBalance Boolean @default(false)

  categoryBudgets CategoryBudget[]
  savingsGoals    SavingsGoal[]
  wallets         Wallet[]
  sharedFundPayments SharedFundPayment[]
  monthCloses     MonthClose[]
  plannedExpenses PlannedExpense[]
}

enum SplitMode {
  FONDO_COMUN
  PORCENTAJE
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  avatar    String?
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Telegram integration
  telegramChatId  String?  @unique
  telegramLinkCode String?
  /// El PIN vence: si no, un código viejo queda válido para siempre y es
  /// forzable a fuerza de probar números de 6 cifras.
  telegramLinkCodeExpiresAt DateTime?

  incomes             Income[]
  expenses            Expense[]
  savingsTransactions SavingsTransaction[]
  investments         Investment[]
  investmentTransactions InvestmentTransaction[]
  budgetConfigs       BudgetConfig[]
  sharedFundPayments  SharedFundPayment[]
  pushSubscriptions   PushSubscription[]
  creditCards         CreditCard[]
  cardPurchases       CardPurchase[]
  cardPayments        CardPayment[]
  loans               Loan[]
  loanPayments        LoanPayment[]
  plannedExpenses     PlannedExpense[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  icon      String    @default("📦")
  color     String    @default("#6366f1")
  accountId String?
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  categoryBudgets CategoryBudget[]
  cardPurchases   CardPurchase[]
  plannedExpenses PlannedExpense[]
  loans           Loan[]
}

model Wallet {
  id        String    @id @default(cuid())
  name      String
  currency  String    @default("ARS")
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  incomes   Income[]
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Income {
  id          String   @id @default(cuid())
  amount      Float
  currency    String   @default("ARS") // ARS, USD, EUR
  date        DateTime
  description String
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  walletId    String?
  wallet      Wallet?  @relation(fields: [walletId], references: [id])

  paymentMethod String @default("TRANSFERENCIA")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Si este ingreso nació del cobro de una cuota de un préstamo otorgado
  loanPayment LoanPayment?
}

model Expense {
  id          String   @id @default(cuid())
  amount      Float
  currency    String   @default("ARS")
  date        DateTime
  description String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  walletId    String?
  wallet      Wallet?  @relation(fields: [walletId], references: [id])

  // Tipo de gasto
  type        ExpenseType @default(PROPIO)

  // Si es COMPARTIDO y se pagó con la billetera personal (ej: Juan paga nafta de sus 50k)
  // El fondo compartido le "debe" ese monto a esa persona
  paidFromPersonalBudget Boolean @default(false)

  // Porcentaje asignado al perfil que pagó/registró (0-100)
  // Usado cuando la cuenta está en modo PORCENTAJE
  splitPercentage Float?

  // Imagen del comprobante
  receiptUrl  String?

  paymentMethod String @default("TRANSFERENCIA")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Si este gasto nació de pagar el resumen de una tarjeta
  cardPayment CardPayment?

  // Si este gasto nació de pagar una cuota de un préstamo
  loanPayment LoanPayment?

  // Si este gasto nació de marcar un ítem de la agenda como pagado
  plannedExpense PlannedExpense?
}

enum ExpenseType {
  PROPIO
  COMPARTIDO
}

// ============================================
// Tarjetas de crédito
// ============================================

/// Una tarjeta pertenece a un perfil (es personal), pero cada consumo
/// puede marcarse como propio o compartido.
model CreditCard {
  id          String  @id @default(cuid())
  name        String  // Ej: "Naranja", "Visa Galicia"
  bank        String?
  lastFour    String? // Últimos 4 dígitos, solo para identificarla
  currency    String  @default("ARS")
  creditLimit Float?  // Límite / monto de la tarjeta
  closingDay  Int     @default(25) // Día de cierre del resumen
  dueDay      Int     @default(10) // Día de vencimiento
  color       String  @default("#f97316")
  isActive    Boolean @default(true)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  purchases CardPurchase[]
  payments  CardPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Un consumo hecho con la tarjeta. NO genera un Expense:
/// el gasto real aparece cuando se paga el resumen (ver CardPayment).
model CardPurchase {
  id           String   @id @default(cuid())
  description  String
  totalAmount  Float // Total del consumo (todas las cuotas)
  currency     String   @default("ARS")
  date         DateTime // Fecha de la compra
  installments Int      @default(1) // Cantidad de cuotas

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  profileId String // Quién hizo el consumo
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  type            ExpenseType @default(PROPIO)
  splitPercentage Float?

  cardId String
  card   CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  schedule CardInstallment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Cada cuota de un consumo, ya asignada al resumen (mes/año) en que se paga.
model CardInstallment {
  id     String @id @default(cuid())
  number Int // 3 de 12
  amount Float
  month  Int // Mes del resumen en que cae
  year   Int

  purchaseId String
  purchase   CardPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@unique([purchaseId, number])
  @@index([month, year])
}

/// Pago del resumen. Esto SÍ genera un Expense real.
/// Lo que no se paga queda como deuda y se arrastra al mes siguiente.
model CardPayment {
  id       String   @id @default(cuid())
  amount   Float
  currency String   @default("ARS")
  date     DateTime
  month    Int // Resumen que se está pagando
  year     Int
  note     String?

  cardId String
  card   CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Gasto generado por este pago. Si se borra el gasto, se borra el pago
  // y la deuda vuelve a figurar.
  expenseId String?  @unique
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([cardId, year, month])
}

// ============================================
// Préstamos
// ============================================

enum LoanKind {
  /// Nos prestaron plata: cada cuota que pagamos es un gasto real.
  TOMADO
  /// Prestamos nosotros: cada cuota que nos devuelven es un ingreso real.
  OTORGADO
}

/// Un préstamo con cuotas fijas. Igual que las tarjetas, el préstamo en sí
/// no mueve el balance: recién impacta cuando se paga (o se cobra) una cuota.
model Loan {
  id                String   @id @default(cuid())
  name              String // Ej: "Préstamo personal Nación"
  lender            String? // Banco, financiera o persona
  kind              LoanKind @default(TOMADO)
  currency          String   @default("ARS")
  principal         Float // Plata que se recibió / se prestó
  totalToRepay      Float // Total a devolver (capital + intereses)
  installments      Int // Cantidad de cuotas
  installmentAmount Float // Valor de cada cuota
  interestRate      Float? // TNA %, informativo
  firstMonth        Int // Mes de la primera cuota
  firstYear         Int
  dueDay            Int      @default(10) // Día del mes en que vence la cuota
  color             String   @default("#8b5cf6")
  notes             String?
  isActive          Boolean  @default(true)

  /// Tipo por defecto para los pagos (propio o compartido).
  type            ExpenseType @default(PROPIO)
  splitPercentage Float?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  schedule LoanInstallment[]
  payments LoanPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Cada cuota del plan de pagos, ya asignada al mes en que vence.
model LoanInstallment {
  id     String @id @default(cuid())
  number Int // 3 de 24
  amount Float
  month  Int
  year   Int

  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, number])
  @@index([month, year])
}

/// Pago (o cobro) de una cuota. Esto SÍ genera un movimiento real:
/// un gasto si el préstamo es TOMADO, un ingreso si es OTORGADO.
model LoanPayment {
  id       String   @id @default(cuid())
  amount   Float
  currency String   @default("ARS")
  date     DateTime
  month    Int // Cuota de qué mes se está pagando
  year     Int
  note     String?

  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  expenseId String?  @unique
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  incomeId String? @unique
  income   Income? @relation(fields: [incomeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([loanId, year, month])
}

// ============================================
// Agenda de gastos previstos
// ============================================

enum PlannedKind {
  /// Todos los meses: alquiler, expensas, colegio.
  FIJO
  /// Puede pasar o no: regalo de cumpleaños, service del auto.
  EVENTUAL
}

enum PlannedStatus {
  PENDIENTE
  HECHO
  /// Este mes no va (se salteó), pero sigue en la agenda de los próximos.
  OMITIDO
}

/// Anotador de gastos previstos del mes. NO afecta el balance:
/// es una ayuda memoria. Si se quiere, se puede convertir en un gasto real.
model PlannedExpense {
  id       String        @id @default(cuid())
  title    String
  amount   Float? // Estimado, opcional
  currency String        @default("ARS")
  day      Int? // Día aproximado del mes
  month    Int
  year     Int
  kind     PlannedKind   @default(FIJO)
  status   PlannedStatus @default(PENDIENTE)
  notes    String?

  /// Se repite todos los meses (se clona solo al abrir el mes siguiente).
  isRecurring Boolean @default(false)
  /// Agrupa todas las repeticiones mensuales del mismo ítem.
  seriesId    String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Quién se encarga (opcional).
  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  /// Gasto real generado desde la agenda. Si se borra el gasto, el ítem queda
  /// igual pero desvinculado.
  expenseId String?  @unique
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, year, month])
  @@index([seriesId])
}

model SavingsGoal {
  id              String   @id @default(cuid())
  name            String
  targetAmount    Float?
  isPiggyBank     Boolean  @default(false)
  currency        String   @default("ARS")
  currentAmount   Float    @default(0)
  
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  monthsToAchieve Int?
  monthlySplits   Json?    // { profileId: amount }

  transactions    SavingsTransaction[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SavingsTransaction {
  id            String      @id @default(cuid())
  amount        Float
  type          SavingsType
  description   String?
  savingsGoalId String
  savingsGoal   SavingsGoal @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)
  profileId     String
  profile       Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date          DateTime    @default(now())
  createdAt     DateTime    @default(now())
}

enum SavingsType {
  DEPOSITO
  RETIRO
}

model Investment {
  id          String          @id @default(cuid())
  name        String
  type        InvestmentType
  amount      Float
  currency    String          @default("ARS")
  returnRate  Float?          // Tasa de retorno anual %
  startDate   DateTime
  endDate     DateTime?
  notes       String?
  profileId   String
  profile     Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)

  transactions InvestmentTransaction[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

/// Movimientos de una inversión. Igual que en los ahorros, sirve para que el
/// balance del mes sepa que la plata salió de la inversión y no de la nada.
/// El alta de la inversión NO genera un movimiento: el monto inicial se
/// reconstruye como (amount actual + retiros).
model InvestmentTransaction {
  id           String      @id @default(cuid())
  amount       Float
  type         SavingsType
  description  String?
  investmentId String
  investment   Investment  @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  profileId    String
  profile      Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date         DateTime    @default(now())
  createdAt    DateTime    @default(now())

  @@index([investmentId])
}

enum InvestmentType {
  PLAZO_FIJO
  FCI
  ACCIONES
  CRYPTO
  BONOS
  OTRO
}

model ExchangeRate {
  id        String   @id @default(cuid())
  month     Int      // 1-12
  year      Int
  usdToArs  Float
  eurToArs  Float
  eurToUsd  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, year])
}

model BudgetConfig {
  id              String  @id @default(cuid())
  profileId       String
  profile         Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  firstHalfBudget Float   @default(50000) // Presupuesto primera quincena ARS
  secondHalfBudget Float  @default(50000) // Presupuesto segunda quincena ARS
  budgetType      String  @default("QUINCENAL") // QUINCENAL o MENSUAL
  monthlyBudget   Float   @default(100000) // Presupuesto mensual ARS
  extraBudget     Float   @default(0)     // Saldo del mes pasado o extra
  currency        String  @default("ARS")
  isActive        Boolean @default(true)

  @@unique([profileId])
}

model CategoryBudget {
  id          String   @id @default(cuid())
  month       Int
  year        Int
  amount      Float
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([accountId, categoryId, month, year])
}

model SharedFundPayment {
  id          String   @id @default(cuid())
  amount      Float
  date        DateTime @default(now())
  description String?
  
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TelegramDraft {
  id           String   @id @default(cuid())
  chatId       String   @unique
  fileIds      String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Acciones que la IA interpretó de un audio o una foto y todavía esperan
/// que la persona las confirme desde Telegram. Nada de esto tocó la base:
/// recién al confirmar se crean los gastos, ingresos o consumos.
model TelegramPending {
  id        String   @id @default(cuid())
  chatId    String
  profileId String
  /// Array de ParsedAction tal cual lo devolvió el modelo.
  actions   Json
  /// De dónde salió: "audio" o "imagen". Solo para el mensaje de resumen.
  origen    String   @default("audio")
  createdAt DateTime @default(now())

  @@index([chatId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model MonthClose {
  id        String   @id @default(cuid())
  month     Int
  year      Int
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  action    String   // "CARRY_OVER" | "SAVINGS" | "IGNORE"
  createdAt DateTime @default(now())

  @@unique([accountId, month, year])
}
