generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // Hash bcrypt
  label     String   // Ej: "Juan & Tania", "Edu & Mai"
  createdAt DateTime @default(now())

  magicToken String? @unique

  profiles   Profile[]
  categories Category[]

  // Configuración de gastos compartidos
  splitMode     SplitMode @default(FONDO_COMUN)
  splitPercentA Float     @default(50) // % del primer perfil (orden alfabético)
  splitPercentB Float     @default(50) // % del segundo perfil
  showSplitBalance Boolean @default(false)

  categoryBudgets CategoryBudget[]
  savingsGoals    SavingsGoal[]
  wallets         Wallet[]
  sharedFundPayments SharedFundPayment[]
  monthCloses     MonthClose[]
}

enum SplitMode {
  FONDO_COMUN
  PORCENTAJE
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  avatar    String?
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Telegram integration
  telegramChatId  String?  @unique
  telegramLinkCode String?

  incomes             Income[]
  expenses            Expense[]
  savingsTransactions SavingsTransaction[]
  investments         Investment[]
  budgetConfigs       BudgetConfig[]
  sharedFundPayments  SharedFundPayment[]
  pushSubscriptions   PushSubscription[]
  creditCards         CreditCard[]
  cardPurchases       CardPurchase[]
  cardPayments        CardPayment[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  icon      String    @default("📦")
  color     String    @default("#6366f1")
  accountId String?
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  categoryBudgets CategoryBudget[]
  cardPurchases   CardPurchase[]
}

model Wallet {
  id        String    @id @default(cuid())
  name      String
  currency  String    @default("ARS")
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  incomes   Income[]
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Income {
  id          String   @id @default(cuid())
  amount      Float
  currency    String   @default("ARS") // ARS, USD, EUR
  date        DateTime
  description String
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  walletId    String?
  wallet      Wallet?  @relation(fields: [walletId], references: [id])

  paymentMethod String @default("TRANSFERENCIA")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  amount      Float
  currency    String   @default("ARS")
  date        DateTime
  description String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  walletId    String?
  wallet      Wallet?  @relation(fields: [walletId], references: [id])

  // Tipo de gasto
  type        ExpenseType @default(PROPIO)

  // Si es COMPARTIDO y se pagó con la billetera personal (ej: Juan paga nafta de sus 50k)
  // El fondo compartido le "debe" ese monto a esa persona
  paidFromPersonalBudget Boolean @default(false)

  // Porcentaje asignado al perfil que pagó/registró (0-100)
  // Usado cuando la cuenta está en modo PORCENTAJE
  splitPercentage Float?

  // Imagen del comprobante
  receiptUrl  String?

  paymentMethod String @default("TRANSFERENCIA")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Si este gasto nació de pagar el resumen de una tarjeta
  cardPayment CardPayment?
}

enum ExpenseType {
  PROPIO
  COMPARTIDO
}

// ============================================
// Tarjetas de crédito
// ============================================

/// Una tarjeta pertenece a un perfil (es personal), pero cada consumo
/// puede marcarse como propio o compartido.
model CreditCard {
  id          String  @id @default(cuid())
  name        String  // Ej: "Naranja", "Visa Galicia"
  bank        String?
  lastFour    String? // Últimos 4 dígitos, solo para identificarla
  currency    String  @default("ARS")
  creditLimit Float?  // Límite / monto de la tarjeta
  closingDay  Int     @default(25) // Día de cierre del resumen
  dueDay      Int     @default(10) // Día de vencimiento
  color       String  @default("#f97316")
  isActive    Boolean @default(true)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  purchases CardPurchase[]
  payments  CardPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Un consumo hecho con la tarjeta. NO genera un Expense:
/// el gasto real aparece cuando se paga el resumen (ver CardPayment).
model CardPurchase {
  id           String   @id @default(cuid())
  description  String
  totalAmount  Float // Total del consumo (todas las cuotas)
  currency     String   @default("ARS")
  date         DateTime // Fecha de la compra
  installments Int      @default(1) // Cantidad de cuotas

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  profileId String // Quién hizo el consumo
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  type            ExpenseType @default(PROPIO)
  splitPercentage Float?

  cardId String
  card   CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  schedule CardInstallment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Cada cuota de un consumo, ya asignada al resumen (mes/año) en que se paga.
model CardInstallment {
  id     String @id @default(cuid())
  number Int // 3 de 12
  amount Float
  month  Int // Mes del resumen en que cae
  year   Int

  purchaseId String
  purchase   CardPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@unique([purchaseId, number])
  @@index([month, year])
}

/// Pago del resumen. Esto SÍ genera un Expense real.
/// Lo que no se paga queda como deuda y se arrastra al mes siguiente.
model CardPayment {
  id       String   @id @default(cuid())
  amount   Float
  currency String   @default("ARS")
  date     DateTime
  month    Int // Resumen que se está pagando
  year     Int
  note     String?

  cardId String
  card   CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Gasto generado por este pago. Si se borra el gasto, se borra el pago
  // y la deuda vuelve a figurar.
  expenseId String?  @unique
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([cardId, year, month])
}

model SavingsGoal {
  id              String   @id @default(cuid())
  name            String
  targetAmount    Float?
  isPiggyBank     Boolean  @default(false)
  currency        String   @default("ARS")
  currentAmount   Float    @default(0)
  
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  monthsToAchieve Int?
  monthlySplits   Json?    // { profileId: amount }

  transactions    SavingsTransaction[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SavingsTransaction {
  id            String      @id @default(cuid())
  amount        Float
  type          SavingsType
  description   String?
  savingsGoalId String
  savingsGoal   SavingsGoal @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)
  profileId     String
  profile       Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date          DateTime    @default(now())
  createdAt     DateTime    @default(now())
}

enum SavingsType {
  DEPOSITO
  RETIRO
}

model Investment {
  id          String          @id @default(cuid())
  name        String
  type        InvestmentType
  amount      Float
  currency    String          @default("ARS")
  returnRate  Float?          // Tasa de retorno anual %
  startDate   DateTime
  endDate     DateTime?
  notes       String?
  profileId   String
  profile     Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum InvestmentType {
  PLAZO_FIJO
  FCI
  ACCIONES
  CRYPTO
  BONOS
  OTRO
}

model ExchangeRate {
  id        String   @id @default(cuid())
  month     Int      // 1-12
  year      Int
  usdToArs  Float
  eurToArs  Float
  eurToUsd  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, year])
}

model BudgetConfig {
  id              String  @id @default(cuid())
  profileId       String
  profile         Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  firstHalfBudget Float   @default(50000) // Presupuesto primera quincena ARS
  secondHalfBudget Float  @default(50000) // Presupuesto segunda quincena ARS
  budgetType      String  @default("QUINCENAL") // QUINCENAL o MENSUAL
  monthlyBudget   Float   @default(100000) // Presupuesto mensual ARS
  extraBudget     Float   @default(0)     // Saldo del mes pasado o extra
  currency        String  @default("ARS")
  isActive        Boolean @default(true)

  @@unique([profileId])
}

model CategoryBudget {
  id          String   @id @default(cuid())
  month       Int
  year        Int
  amount      Float
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([accountId, categoryId, month, year])
}

model SharedFundPayment {
  id          String   @id @default(cuid())
  amount      Float
  date        DateTime @default(now())
  description String?
  
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TelegramDraft {
  id           String   @id @default(cuid())
  chatId       String   @unique
  fileIds      String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model MonthClose {
  id        String   @id @default(cuid())
  month     Int
  year      Int
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  action    String   // "CARRY_OVER" | "SAVINGS" | "IGNORE"
  createdAt DateTime @default(now())

  @@unique([accountId, month, year])
}
